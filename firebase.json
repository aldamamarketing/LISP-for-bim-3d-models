{
  "hosting": {
    "public": "web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/palette",
        "destination": "/palette-builds/palette.html"
      },
      {
        "source": "/resource-palette",
        "destination": "/palette-builds/resource-palette.html"
      },
      {
        "source": "/properties-palette",
        "destination": "/palette-builds/properties-palette.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "codebase": "default"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
