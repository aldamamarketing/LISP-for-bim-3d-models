rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /publicAssets/{assetId} {
      allow read: if true;
      allow create: if request.auth != null; // Usuarios pueden aportar
      allow update, delete: if false;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId}/devices/{deviceId} {
      allow read, write: if request.auth != null;
    }
    
    // Phase B & C Collections
    match /lispFiles/{fileId} {
      allow read, write: if request.auth != null;
    }
    match /commands/{commandId} {
      allow read: if true; // Public store needs to read commands
      allow write: if request.auth != null;
    }
    match /suites/{suiteId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /groups/{groupId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /groupFiles/{gfileId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /subscriptions/{subId} {
      allow read, write: if request.auth != null;
    }
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
