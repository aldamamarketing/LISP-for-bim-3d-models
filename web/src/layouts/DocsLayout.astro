---
import '../styles/global.css';
import '../styles/styles.css';
import Header from '../components/layout/Header.astro';
import { getLangFromUrl } from '../i18n/utils';

const { 
  title = "LispCentral Docs — Superpoderes para seu AutoCAD",
  description = "Documentação oficial de rotinas AutoLISP e plugins JIT para AutoCAD. Baixe rotinas LISP prontas para aumentar sua produtividade.",
  keywords = "lisp autocad, autolisp, rotinas lisp, autocad lisp download, autocad lt lisp, lisp viga, lisp civil 3d",
  canonicalUrl = Astro.url.href
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
---
<!DOCTYPE html>
<html lang={lang} class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="LispCentral" />
  
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
</head>
<body class="bg-background text-on-surface m-0 p-0 flex flex-col h-screen overflow-hidden">
  
  <Header />

  <!-- The layout container below the fixed header -->
  <div class="layout-container flex flex-1 overflow-hidden relative pt-[60px]">
    
    <aside class="sidebar w-[260px] bg-surface-container border-r border-surface-variant overflow-y-auto p-5 shrink-0 z-[85] absolute md:relative h-full hidden md:block">
      <nav class="sidebar-nav">
        <h4 class="text-primary-container uppercase text-xs font-bold tracking-wider mb-2 mt-0">Meu Painel</h4>
        <ul class="list-none p-0 m-0 mb-4">
          <li class="mb-1"><a href="/dashboard" class="block py-1.5 px-3 text-on-surface-variant hover:text-white hover:bg-surface-container-high rounded-md transition-colors text-sm">Minha Assinatura</a></li>
          <li class="mb-1"><a href="/pt/docs/install" class="block py-1.5 px-3 text-on-surface-variant hover:text-white hover:bg-surface-container-high rounded-md transition-colors text-sm">Instalação</a></li>
        </ul>
        
        <hr class="border-0 border-t border-dashed border-surface-variant my-4" />

        <h4 class="text-primary-container uppercase text-xs font-bold tracking-wider mb-2">Ferramentas Web</h4>
        <ul class="list-none p-0 m-0 mb-4">
          <li class="mb-1"><a href="/tools/calc-viga" class="block py-1.5 px-3 text-on-surface-variant hover:text-white hover:bg-surface-container-high rounded-md transition-colors text-sm">Calculadora de Vigas</a></li>
          <li class="mb-1"><a href="/tools/icon-generator" class="block py-1.5 px-3 text-on-surface-variant hover:text-white hover:bg-surface-container-high rounded-md transition-colors text-sm">Gerador de Ícones</a></li>
          <li class="mb-1"><a href="/tools/hatch-generator" class="block py-1.5 px-3 text-on-surface-variant hover:text-white hover:bg-surface-container-high rounded-md transition-colors text-sm">Gerador de Hatch</a></li>
          <li class="mb-1"><a href="/tools/linetype-generator" class="block py-1.5 px-3 text-on-surface-variant hover:text-white hover:bg-surface-container-high rounded-md transition-colors text-sm">Gerador de Linetype</a></li>
        </ul>
      </nav>
    </aside>

    <main class="content-area flex-1 overflow-y-auto bg-background relative flex flex-col">
      <div class="flex-1 p-4 md:p-8 overflow-y-auto">
        <slot />
      </div>
    </main>
  </div>

  <script>
    import { initPageTracking, trackDocView, trackCtaClick } from '../utils/analytics.js';
    initPageTracking();
    const path = window.location.pathname;
    if (path.includes('/docs/')) {
      const slug = path.split('/docs/').pop()?.replace(/\/$/, '');
      if (slug) trackDocView(slug);
    } else if (path.includes('/tools/')) {
      const slug = path.split('/tools/').pop()?.replace(/\/$/, '');
      if (slug) trackDocView('tool_' + slug);
    }
    const sidebarLinks = document.querySelectorAll('.sidebar-nav a');
    sidebarLinks.forEach(link => {
      link.addEventListener('click', () => {
        const href = link.getAttribute('href') || '';
        trackCtaClick('sidebar_nav', href);
      });
    });
  </script>

  <style>
    /* Keep doc layout column styles */
    :global(.doc-content) {
      column-count: 2;
      column-gap: 40px;
      column-rule: 1px solid var(--border-color);
      text-align: justify;
    }
    @media (max-width: 900px) {
      :global(.doc-content) { 
        column-count: 1; 
        text-align: left; 
      }
    }
  </style>
</body>
</html>
