---
import '../styles/styles.css';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';

const { title = "LispCentral Docs" } = Astro.props;
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
</head>
<body>
  <header class="topbar">
    <div style="display: flex; align-items: center; gap: 20px;">
      <a href="/" style="text-decoration: none;">
        <Logo />
      </a>
      <a href="/" class="btn-topbar">Home</a>
    </div>
    <div class="topbar-actions">
      <select class="lang-selector">
        <option value="pt">Português</option>
        <option value="es">Español</option>
        <option value="en">English</option>
      </select>
      <a href="/login" class="btn-topbar active" id="btn-login-portal">Portal do Cliente</a>
    </div>
  </header>

  <div class="layout-container">
    <aside class="sidebar">
      <nav class="sidebar-nav">
        <h4>Meu Painel</h4>
        <ul>
          <li><a href="/dashboard">Minha Assinatura</a></li>
          <li><a href="/pt/docs/install">Instalação</a></li>
        </ul>
        
        <h4>LispCentral Core</h4>
        <ul>
          <li><a href="/pt/docs/lc-clean">LC_CLEAN</a></li>
          <li><a href="/pt/docs/lc-flatz">LC_FLATZ</a></li>
        </ul>

        <h4>Estruturas Metálicas</h4>
        <ul>
          <li><a href="/pt/docs/lc-build">LC_BUILD</a></li>
          <li><a href="/pt/docs/lc-joints">LC_JOINTS</a></li>
        </ul>
      </nav>
    </aside>

    <main class="content-area">
      <!-- Slot for Markdown content or React Dashboard -->
      <slot />
    </main>
  </div>

  <Footer />

  <style>
    /* Layout Framework */
    body {
      margin: 0; padding: 0;
      background-color: var(--bg-darker);
      display: flex; flex-direction: column;
      height: 100vh; overflow: hidden;
    }
    
    .topbar {
      height: 60px;
      background-color: var(--bg-dark);
      border-bottom: 1px solid var(--border-color);
      display: flex; justify-content: space-between; align-items: center;
      padding: 0 20px;
      flex-shrink: 0;
    }

    .topbar-actions {
      display: flex; align-items: center; gap: 15px;
    }

    .lang-selector {
      background: var(--bg-card); color: var(--text-main);
      border: 1px solid var(--border-color); border-radius: 4px;
      padding: 5px 10px; font-size: 0.9rem;
    }

    .btn-topbar {
      color: var(--text-main); text-decoration: none; font-size: 0.9rem;
      padding: 5px 10px; border-radius: 4px; transition: background 0.2s;
    }
    .btn-topbar:hover, .btn-topbar.active {
      background: var(--bg-card); color: var(--tmd-orange);
    }

    .layout-container {
      display: flex;
      flex: 1;
      overflow: hidden;
    }

    .sidebar {
      width: 250px; background-color: var(--bg-card);
      border-right: 1px solid var(--border-color);
      overflow-y: auto; padding: 20px; flex-shrink: 0;
    }
    
    body.hide-sidebar .sidebar {
      display: none;
    }

    .sidebar h4 { color: var(--tmd-orange); margin: 20px 0 10px 0; font-size: 0.85rem; text-transform: uppercase; }
    .sidebar h4:first-child { margin-top: 0; }
    
    .sidebar-nav ul { list-style: none; padding: 0; margin: 0; }
    .sidebar-nav li { margin-bottom: 5px; }
    .sidebar-nav a {
      color: var(--text-muted); text-decoration: none; font-size: 0.95rem;
      display: block; padding: 5px 10px; border-radius: 4px;
    }
    .sidebar-nav a:hover { background-color: rgba(242, 109, 33, 0.1); color: var(--text-main); }

    .content-area {
      flex: 1; overflow-y: auto; padding: 40px;
    }

    /* Column layout for docs (applied only to doc-content wrapper inside MDX/Astro pages) */
    :global(.doc-content) {
      column-count: 2;
      column-gap: 40px;
      column-rule: 1px solid var(--border-color);
      text-align: justify;
    }

    @media (max-width: 900px) {
      .layout-container { flex-direction: column; }
      .sidebar { width: 100%; height: 200px; border-right: none; border-bottom: 1px solid var(--border-color); }
      :global(.doc-content) { column-count: 1; text-align: left; }
    }
  </style>
</body>
</html>
