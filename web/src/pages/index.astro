---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/landing/Hero.astro';
import HatchSection from '../components/landing/HatchSection.astro';
import StandardsSection from '../components/landing/StandardsSection.astro';
import LispSection from '../components/landing/LispSection.astro';
import WorkflowSection from '../components/landing/WorkflowSection.astro';
import Features from '../components/landing/Features.astro';
import WebPalettes from '../components/landing/WebPalettes.astro';
import FAQ from '../components/landing/FAQ.astro';
import CTA from '../components/landing/CTA.astro';

import { getLangFromUrl } from '../i18n/utils';
import { translations } from '../i18n/translations.js';

const lang = getLangFromUrl(Astro.url);
const t = (key) => translations[lang]?.[key] || translations['en'][key] || key;
---

<Layout title={t('landing.meta.title')} description={t('landing.meta.desc')}>
    <script is:inline>
      (function() {
        if (window.location.pathname !== '/') return;
        const savedLang = localStorage.getItem('lc-lang');
        if (savedLang) {
          if (savedLang === 'es') window.location.replace('/es/');
          if (savedLang === 'pt') window.location.replace('/pt/');
          return;
        }
        const browserLang = navigator.language || navigator.userLanguage;
        if (browserLang) {
          const lowerLang = browserLang.toLowerCase();
          if (lowerLang.startsWith('es')) {
            localStorage.setItem('lc-lang', 'es');
            window.location.replace('/es/');
          } else if (lowerLang.startsWith('pt')) {
            localStorage.setItem('lc-lang', 'pt');
            window.location.replace('/pt/');
          }
        }
      })();
    </script>
    <Header />
    <main id="modules">
        <Hero />
        <HatchSection />
        <StandardsSection />
        <LispSection />
        <WorkflowSection />
        <Features />
        <WebPalettes />
        <FAQ />
        <CTA />
    </main>
    <Footer />
</Layout>

