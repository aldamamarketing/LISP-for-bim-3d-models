---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
---

<Layout title="404 - Página no encontrada | LispCentral">
  <Header />

  <main class="flex-1 flex flex-col items-center justify-center text-center px-6 py-32 bg-[radial-gradient(ellipse_at_50%_50%,rgba(242,109,33,0.1)_0%,transparent_60%)] min-h-[calc(100vh-80px)] mt-20">
    <h1 class="text-[clamp(6rem,15vw,10rem)] font-extrabold leading-none text-primary-container mb-5 drop-shadow-[0_0_40px_rgba(242,109,33,0.3)] tracking-tighter">
      404
    </h1>
    <h2 class="text-[clamp(2rem,5vw,3rem)] font-bold text-white mb-4 tracking-tight">
      <span class="text-primary-container">L</span>ost <span class="text-primary-container">I</span>n <span class="text-primary-container">S</span>yntax <span class="text-primary-container">P</span>arentheses
    </h2>
    
    <div class="text-5xl text-on-surface-variant mb-6 font-mono">
      ;; ¯\_(ツ)_/¯
    </div>

    <p class="text-xl text-on-surface-variant max-w-[600px] mb-10 font-normal">
      ;; Parece que me perdi entre tantos parênteses...
    </p>
    
    <div class="flex gap-4 flex-wrap justify-center">
      <a href="/" class="inline-flex items-center justify-center px-10 py-4 bg-primary-container text-white rounded-lg text-lg font-bold transition-all hover:bg-[#e06019] hover:-translate-y-0.5 shadow-[0_4px_20px_rgba(242,109,33,0.25)] hover:shadow-[0_8px_30px_rgba(242,109,33,0.4)]">
        Voltar ao Início
      </a>
      <a href="/blog" class="inline-flex items-center justify-center px-10 py-4 bg-white/5 text-white border border-white/10 rounded-lg text-lg font-medium transition-all hover:bg-white/10 hover:border-white/20">
        Ler o Blog
      </a>
    </div>
  </main>
</Layout>
