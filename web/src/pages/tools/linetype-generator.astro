---
import DocsLayout from '../../layouts/DocsLayout.astro';
import LinetypeGenerator from '../../components/tools/LinetypeGenerator.jsx';
---

<DocsLayout 
  title="Gerador de Linetype AutoCAD — Criar Linhas .LIN | LispCentral" 
  description="Gere tipos de linha complexos (.lin) para AutoCAD usando Inteligência Artificial. Insira textos e formatos e a IA calcula a matemática da linha."
  keywords="autocad linetype generator, criar linetype autocad, lin generator, lisp linetype, gerador de linha IA"
>
  <div class="tool-container">
    <div class="tool-header">
      <h1>Gerador de Tipos de Linha (Linetype) <span class="badge">BETA</span></h1>
      <p>Crie definições complexas (.lin) com textos e formas integradas para AutoCAD usando comandos textuais y Inteligência Artificial.</p>
    </div>

    <!-- Carga del componente React en el cliente -->
    <LinetypeGenerator client:load />

  </div>
</DocsLayout>

<style>
  .tool-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 20px;
    height: calc(100vh - 140px);
    display: flex;
    flex-direction: column;
  }
  
  .tool-header {
    margin-bottom: 20px;
    flex-shrink: 0;
  }
  
  .tool-header h1 {
    font-size: 2rem;
    color: var(--text-main);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 15px;
  }
  
  .tool-header p {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 800px;
  }
  
  .badge {
    background-color: rgba(242, 109, 33, 0.2);
    color: var(--tmd-orange);
    font-size: 0.8rem;
    padding: 4px 8px;
    border-radius: 4px;
    font-weight: 600;
    vertical-align: middle;
  }
</style>
