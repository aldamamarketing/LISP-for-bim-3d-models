---
import DocsLayout from '../layouts/DocsLayout.astro';
import SuiteProductPage from '../components/store/SuiteProductPage.jsx';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<DocsLayout title="Suite Details - LispCentral" description="Detalhes da Suite">
  <main className="p-4 md:p-8 max-w-[1200px] md:ml-[260px] min-h-screen bg-grid-pattern relative">
    <div className="relative z-10">
      <SuiteProductPage client:only="react" />
    </div>
  </main>
</DocsLayout>
