---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { getLangFromUrl, localizeUrl } from '../../../i18n/utils';
import { translations } from '../../../i18n/translations.js';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map(doc => {
    const [lang, ...slugParts] = doc.id.split('/');
    return {
      params: { lang: lang === 'en' ? undefined : lang, slug: slugParts.join('/') || undefined },
      props: { doc },
    };
  });
}

const { doc } = Astro.props;
const { Content } = await render(doc);
const lang = getLangFromUrl(Astro.url);
const currentLocale = lang || 'en';
const t = (key) => {
    const dict = translations[currentLocale] || translations['en'];
    return dict[key] || key;
};
---

<DocsLayout 
  title={`${doc.data.title} - LispCentral Help`}
  description={doc.data.description}
>
  <article class="help-post max-w-[800px] mx-auto px-6 py-12 text-white">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs mb-8" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-sm text-on-surface-variant">
        <li><a href={localizeUrl("/", lang)} class="hover:text-primary-container">{t("nav.home")}</a></li>
        <li><span class="separator material-symbols-outlined text-[16px]">chevron_right</span></li>
        <li><a href={localizeUrl("/help", lang)} class="hover:text-primary-container">{t("nav.help")}</a></li>
        <li><span class="separator material-symbols-outlined text-[16px]">chevron_right</span></li>
        <li aria-current="page" class="text-white">{doc.data.title}</li>
      </ol>
    </nav>

    <header class="mb-12">
      {doc.data.icon && <span class="material-symbols-outlined text-4xl text-primary-container mb-4 block">{doc.data.icon}</span>}
      <h1 class="text-headline-lg font-bold text-primary-container mb-4">{doc.data.title}</h1>
      <p class="text-body-lg text-on-surface-variant">{doc.data.description}</p>
    </header>

    <div class="post-content prose prose-invert prose-orange max-w-none">
      <Content />
    </div>
  </article>
</DocsLayout>

<style>
  /* Markdown Styles for content */
  :global(.post-content h2) {
    font-size: 1.8rem;
    margin: 40px 0 20px;
    color: #fff;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 10px;
  }
  
  :global(.post-content h3) {
    font-size: 1.4rem;
    margin: 30px 0 15px;
    color: #f0f0f0;
  }
  
  :global(.post-content p) {
    margin-bottom: 20px;
    line-height: 1.8;
  }
  
  :global(.post-content ul), :global(.post-content ol) {
    margin-bottom: 20px;
    padding-left: 20px;
    line-height: 1.8;
  }
  
  :global(.post-content li) {
    margin-bottom: 10px;
  }
  
  :global(.post-content code) {
    background: #1a1a1a;
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid #333;
    color: #a6e22e;
    font-family: 'Consolas', monospace;
  }
</style>
