---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { translations } from '../../../i18n/translations.js';
import { getCollection } from 'astro:content';
import { getLangFromUrl, localizeUrl } from '../../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'es' } },
    { params: { lang: 'pt' } },
  ];
}

const lang = getLangFromUrl(Astro.url);
const t = (key) => {
    const dict = translations[lang] || translations['en'];
    return dict[key] || key;
};

const allDocs = await getCollection('docs');
const docs = allDocs.filter(doc => doc.id.startsWith(`${lang}/`));
---

<DocsLayout title="Help & Docs - LispCentral">
  <main class="min-h-screen bg-background text-white px-6 py-12 max-w-[1000px]">
    <div class="mb-16">
      <h1 class="text-headline-lg font-headline-lg font-bold text-primary-container mb-4">{t("help.title")}</h1>
      <p class="text-body-lg text-on-surface-variant max-w-[600px]">{t("help.desc")}</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      {docs.map((doc) => {
        const slug = doc.id.replace(`${lang}/`, '');
        return (
        <a href={localizeUrl(`/help/${slug}/`, lang)} class="group block bg-surface-container p-8 rounded-2xl border border-surface-variant hover:border-primary-container transition-all hover:-translate-y-1">
            {doc.data.icon && <span class="material-symbols-outlined text-4xl text-primary-container mb-4 block">{doc.data.icon}</span>}
            <h2 class="text-title-lg font-bold mb-3 text-white group-hover:text-primary-container transition-colors">{doc.data.title}</h2>
            <p class="text-body-md text-on-surface-variant">{doc.data.description}</p>
        </a>
      )})}
    </div>
  </main>
</DocsLayout>
