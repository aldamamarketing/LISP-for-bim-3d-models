---
export function getStaticPaths() { return [{params: {lang: 'es'}}, {params: {lang: 'pt'}}]; }
const { lang } = Astro.params;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Hero from '../../components/landing/Hero.astro';
import HatchSection from '../../components/landing/HatchSection.astro';
import StandardsSection from '../../components/landing/StandardsSection.astro';
import LispSection from '../../components/landing/LispSection.astro';
import WorkflowSection from '../../components/landing/WorkflowSection.astro';
import Features from '../../components/landing/Features.astro';
import WebPalettes from '../../components/landing/WebPalettes.astro';
import FAQ from '../../components/landing/FAQ.astro';
import CTA from '../../components/landing/CTA.astro';
---

<Layout title="LispCentral | Hatch Library, CAD Standards & LISP Cloud for CAD Professionals">
    <Header />
    <main id="modules">
        <Hero />
        <HatchSection />
        <StandardsSection />
        <LispSection />
        <WorkflowSection />
        <Features />
        <WebPalettes />
        <FAQ />
        <CTA />
    </main>
    <Footer />
</Layout>

