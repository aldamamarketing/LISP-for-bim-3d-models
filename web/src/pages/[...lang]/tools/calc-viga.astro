---
export function getStaticPaths() { return [{params: {lang: 'es'}}, {params: {lang: 'pt'}}]; }
const { lang } = Astro.params;
import DocsLayout from '../../../layouts/DocsLayout.astro';
---

<DocsLayout 
  title="Calculadora de Perfis de Aço & Vigas para AutoCAD"
  description="Calcule propriedades estruturais (área, inercia, peso) de perfis metálicos Gerdau, AISC, Metalon e exporte diretamente para seu AutoCAD."
  keywords="calculadora viga, perfil gerdau, inercia perfil, metalon tabela, lisp viga gerdau, autocad perfis metalicos"
>
  <div class="calc-container">
    <div class="calc-header">
      <h1>Calculadora de Perfis de Aço (2D/3D)</h1>
      <p>Selecione um perfil normatizado ou customize as dimensões. Calcule as propriedades de engenharia instantaneamente e gere o comando para desenhar direto no seu AutoCAD.</p>
    </div>

    <div class="calc-grid">
      <!-- PANEL DE CONTROL -->
      <div class="panel card">
        <h3>1. Configurar Perfil</h3>
        
        <div class="form-group">
          <label for="standard-select">Norma / Catálogo</label>
          <select id="standard-select" class="form-control">
            <option value="gerdau">Perfis Gerdau / Padrão ABNT</option>
            <option value="metalon_tubos">Tubos & Metalon Estruturais</option>
          </select>
        </div>

        <div class="form-group">
          <label for="profile-select">Bitola / Perfil</label>
          <select id="profile-select" class="form-control">
            <!-- Cargado por JS -->
          </select>
        </div>

        <hr class="divider" />

        <h4>Dimensões do Perfil (mm)</h4>
        
        <div class="dims-grid">
          <div class="form-group">
            <label for="dim-h">Altura (h)</label>
            <input type="number" id="dim-h" class="form-control input-dim" step="0.1" />
          </div>
          <div class="form-group">
            <label for="dim-b">Largura da Aba (b)</label>
            <input type="number" id="dim-b" class="form-control input-dim" step="0.1" />
          </div>
          <div class="form-group">
            <label for="dim-tw">Alma (tw) / Espessura</label>
            <input type="number" id="dim-tw" class="form-control input-dim" step="0.1" />
          </div>
          <div class="form-group" id="group-tf">
            <label for="dim-tf">Mesa (tf)</label>
            <input type="number" id="dim-tf" class="form-control input-dim" step="0.1" />
          </div>
          <div class="form-group" id="group-lip" style="display:none;">
            <label for="dim-lip">Aba / Lip (d)</label>
            <input type="number" id="dim-lip" class="form-control input-dim" step="0.1" />
          </div>
        </div>
      </div>

      <!-- PREVIEW & RESULTADOS -->
      <div class="preview-results">
        <!-- SVG PREVIEW -->
        <div class="preview-card card">
          <h3>2. Preview da Seção</h3>
          <div class="svg-wrapper">
            <svg id="profile-svg" viewBox="-100 -100 200 200" width="100%" height="240">
              <!-- Renderizado por JS -->
            </svg>
          </div>
        </div>

        <!-- STRUCTURAL DATA -->
        <div class="results-card card">
          <h3>3. Propriedades Estruturais</h3>
          <div class="results-grid">
            <div class="result-item">
              <span class="label">Área da Seção</span>
              <span class="value" id="res-area">0.00</span>
              <span class="unit">cm²</span>
            </div>
            <div class="result-item">
              <span class="label">Peso Linear</span>
              <span class="value" id="res-weight">0.00</span>
              <span class="unit">kg/m</span>
            </div>
            <div class="result-item">
              <span class="label">Inércia X (Ix)</span>
              <span class="value" id="res-ix">0.00</span>
              <span class="unit">cm⁴</span>
            </div>
            <div class="result-item">
              <span class="label">Inércia Y (Iy)</span>
              <span class="value" id="res-iy">0.00</span>
              <span class="unit">cm⁴</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- AUTOCAD INTEGRATION HOOK -->
    <div class="autocad-hook card">
      <div class="hook-icon">⚡</div>
      <div class="hook-info">
        <h3>Desenhar no AutoCAD via LispCentral</h3>
        <p>Você pode desenhar esta viga/perfil no AutoCAD instantaneamente! Copie o comando e cole diretamente no AutoCAD com a extensão LispCentral carregada.</p>
        
        <div class="code-box">
          <code id="cad-code-text">(EST-STEEL-Beam "W150 x 13.0" 148 100 4.3 4.9)</code>
          <button id="btn-copy-code" class="btn-copy">Copiar</button>
        </div>
      </div>
    </div>
  </div>

  <style>
    .calc-container {
      max-width: 1000px;
      margin: 0 auto;
      color: var(--text-main);
    }
    
    .calc-header {
      margin-bottom: 30px;
    }
    .calc-header h1 {
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--tmd-orange);
      margin-bottom: 10px;
    }
    .calc-header p {
      color: var(--text-muted);
      font-size: 1.05rem;
      line-height: 1.6;
    }

    .calc-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      margin-bottom: 30px;
    }

    @media (max-width: 768px) {
      .calc-grid {
        grid-template-columns: 1fr;
      }
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.15);
    }

    .form-group {
      margin-bottom: 20px;
    }
    .form-group label {
      display: block;
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 8px;
    }
    .form-control {
      width: 100%;
      background: var(--bg-darker);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      border-radius: 6px;
      padding: 10px 14px;
      font-size: 0.95rem;
      transition: border-color 0.2s;
    }
    .form-control:focus {
      outline: none;
      border-color: var(--tmd-orange);
    }

    .divider {
      border: 0;
      height: 1px;
      background: var(--border-color);
      margin: 25px 0;
    }

    .dims-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }

    .preview-results {
      display: flex;
      flex-direction: column;
      gap: 30px;
    }

    .svg-wrapper {
      background: var(--bg-darker);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 10px;
    }

    .results-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 15px;
    }

    .result-item {
      background: var(--bg-darker);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 15px;
      text-align: center;
    }

    .result-item .label {
      display: block;
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 5px;
    }

    .result-item .value {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--tmd-orange);
    }

    .result-item .unit {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-left: 2px;
    }

    /* AUTOCAD HOOK CARD */
    .autocad-hook {
      display: flex;
      gap: 20px;
      background: linear-gradient(135deg, rgba(242,109,33,0.08) 0%, rgba(0,0,0,0) 100%);
      border: 1px solid rgba(242,109,33,0.2);
    }

    .hook-icon {
      font-size: 2.2rem;
      color: var(--tmd-orange);
      align-self: center;
    }

    .hook-info h3 {
      font-size: 1.2rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 5px;
    }
    .hook-info p {
      color: var(--text-muted);
      font-size: 0.92rem;
      margin-bottom: 15px;
    }

    .code-box {
      background: var(--bg-darker);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
    }

    .code-box code {
      font-family: monospace;
      color: var(--tmd-orange);
      font-size: 0.95rem;
      word-break: break-all;
    }

    .btn-copy {
      background: var(--tmd-orange);
      color: #fff;
      border: none;
      border-radius: 4px;
      padding: 6px 14px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      flex-shrink: 0;
      transition: background 0.2s;
    }
    .btn-copy:hover {
      background: #d95d18;
    }
  </style>

  <script is:inline>
    let currentCatalog = [];
    
    // Configuración de los elementos del DOM
    const stdSelect = document.getElementById('standard-select');
    const profSelect = document.getElementById('profile-select');
    const svgElem = document.getElementById('profile-svg');
    
    const inputH = document.getElementById('dim-h');
    const inputB = document.getElementById('dim-b');
    const inputTw = document.getElementById('dim-tw');
    const inputTf = document.getElementById('dim-tf');
    const inputLip = document.getElementById('dim-lip');
    
    const groupTf = document.getElementById('group-tf');
    const groupLip = document.getElementById('group-lip');
    
    const resArea = document.getElementById('res-area');
    const resWeight = document.getElementById('res-weight');
    const resIx = document.getElementById('res-ix');
    const resIy = document.getElementById('res-iy');
    
    const cadCodeText = document.getElementById('cad-code-text');
    const btnCopy = document.getElementById('btn-copy-code');

    // Cargar base de datos de perfiles
    async function init() {
      try {
        const response = await fetch('/data/steel_profiles.json');
        const data = await response.json();
        
        stdSelect.addEventListener('change', (e) => {
          const std = data.standards.find(s => s.id === e.target.value);
          if (std) populateProfiles(std.profiles);
        });

        // Carga inicial
        const initialStd = data.standards.find(s => s.id === stdSelect.value);
        if (initialStd) populateProfiles(initialStd.profiles);
        
      } catch (err) {
        console.error("Erro ao carregar banco de dados de perfis:", err);
      }
    }

    function populateProfiles(profiles) {
      currentCatalog = profiles;
      profSelect.innerHTML = '';
      profiles.forEach((profile, idx) => {
        const option = document.createElement('option');
        option.value = idx;
        option.textContent = profile.name;
        profSelect.appendChild(option);
      });

      profSelect.addEventListener('change', (e) => {
        loadProfileData(profiles[e.target.value]);
      });

      if (profiles.length > 0) {
        loadProfileData(profiles[0]);
      }
    }

    function loadProfileData(profile) {
      if (!profile) return;
      
      // Llenar inputs
      inputH.value = profile.h;
      inputB.value = profile.b;
      inputTw.value = profile.tw;
      
      if (profile.tf !== undefined) {
        groupTf.style.display = 'block';
        inputTf.value = profile.tf;
      } else {
        groupTf.style.display = 'none';
      }

      if (profile.lip !== undefined) {
        groupLip.style.display = 'block';
        inputLip.value = profile.lip;
      } else {
        groupLip.style.display = 'none';
      }

      // Resultados
      resArea.textContent = profile.area.toFixed(2);
      resWeight.textContent = profile.weight.toFixed(2);
      resIx.textContent = profile.ix.toFixed(2);
      resIy.textContent = profile.iy.toFixed(2);

      // AutoCAD code preview
      const params = [
        `"${profile.name}"`,
        profile.h,
        profile.b,
        profile.tw,
        profile.tf !== undefined ? profile.tf : 0.0
      ];
      cadCodeText.textContent = `(EST-STEEL-Beam ${params.join(" ")})`;

      drawSVG(profile);
    }

    // Dibujado del SVG
    function drawSVG(profile) {
      svgElem.innerHTML = '';
      
      const h = profile.h;
      const b = profile.b;
      const tw = profile.tw;
      const tf = profile.tf || 0.0;
      const lip = profile.lip || 0.0;
      
      // Escalamiento dinámico para que entre en [-80, -80, 160, 160]
      const maxDim = Math.max(h, b);
      const scale = 140 / maxDim; // deja un margen
      
      const sh = h * scale;
      const sb = b * scale;
      const stw = tw * scale;
      const stf = tf * scale;
      const slip = lip * scale;
      
      let pathData = '';
      
      if (profile.shape === 'PERFIL_I') {
        // Dibujar viga H/I
        pathData = `
          M ${-sb/2} ${-sh/2} 
          h ${sb} 
          v ${stf} 
          h ${-(sb - stw)/2} 
          v ${sh - 2*stf} 
          h ${(sb - stw)/2} 
          v ${stf} 
          h ${-sb} 
          v ${-stf} 
          h ${(sb - stw)/2} 
          v ${-(sh - 2*stf)} 
          h ${-(sb - stw)/2} 
          Z`;
      } 
      else if (profile.shape === 'PERFIL_U') {
        // Canal U simple
        pathData = `
          M ${-sb/2} ${-sh/2} 
          h ${sb} 
          v ${stf} 
          h ${-(sb - stw)} 
          v ${sh - 2*stf} 
          h ${(sb - stw)} 
          v ${stf} 
          h ${-sb} 
          Z`;
      }
      else if (profile.shape === 'PERFIL_C') {
        // Perfil C con labio (U enrijecido)
        pathData = `
          M ${-sb/2} ${-sh/2} 
          h ${sb} 
          v ${slip} 
          h ${-stw} 
          v ${-(slip - stf)} 
          h ${-(sb - 2*stw)} 
          v ${sh - 2*stf} 
          h ${(sb - 2*stw)} 
          v ${-(slip - stf)} 
          h ${stw} 
          v ${slip} 
          h ${-sb} 
          Z`;
      }
      else if (profile.shape === 'RECT_VAZIO') {
        // Metalon (Hollow rect)
        // Outer rect
        const outer = `M ${-sb/2} ${-sh/2} h ${sb} v ${sh} h ${-sb} Z`;
        // Inner rect (sentido antihorario para sustracción SVG)
        const innerWidth = sb - 2*stw;
        const innerHeight = sh - 2*stw;
        const inner = `M ${-innerWidth/2} ${innerHeight/2} h ${innerWidth} v ${-innerHeight} h ${-innerWidth} Z`;
        pathData = `${outer} ${inner}`;
      }
      else if (profile.shape === 'CIRC_VAZIO') {
        // Tubo redondo
        const rOut = sb / 2;
        const rIn = (sb - 2*stw) / 2;
        // Dos arcos concéntricos para hacer la rosca
        pathData = `
          M 0 ${-rOut} 
          A ${rOut} ${rOut} 0 1 0 0.01 ${-rOut} 
          M 0 ${-rIn} 
          A ${rIn} ${rIn} 0 1 1 -0.01 ${-rIn} 
          Z`;
      }

      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', pathData);
      path.setAttribute('fill', 'var(--tmd-orange)');
      path.setAttribute('fill-opacity', '0.2');
      path.setAttribute('stroke', 'var(--tmd-orange)');
      path.setAttribute('stroke-width', '2');
      path.setAttribute('fill-rule', 'evenodd');
      
      // Ejes coordenados de fondo
      const lineX = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      lineX.setAttribute('x1', '-90'); lineX.setAttribute('y1', '0');
      lineX.setAttribute('x2', '90'); lineX.setAttribute('y2', '0');
      lineX.setAttribute('stroke', 'var(--border-color)');
      lineX.setAttribute('stroke-dasharray', '4,4');

      const lineY = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      lineY.setAttribute('x1', '0'); lineY.setAttribute('y1', '-90');
      lineY.setAttribute('x2', '0'); lineY.setAttribute('y2', '90');
      lineY.setAttribute('stroke', 'var(--border-color)');
      lineY.setAttribute('stroke-dasharray', '4,4');

      svgElem.appendChild(lineX);
      svgElem.appendChild(lineY);
      svgElem.appendChild(path);
    }

    // Lógica para recalcular propiedades si cambian los inputs
    function setupInputListeners() {
      const inputs = [inputH, inputB, inputTw, inputTf, inputLip];
      inputs.forEach(input => {
        input.addEventListener('input', () => {
          recalculateFromInputs();
        });
      });
    }

    function recalculateFromInputs() {
      const h = parseFloat(inputH.value) || 0;
      const b = parseFloat(inputB.value) || 0;
      const tw = parseFloat(inputTw.value) || 0;
      const tf = parseFloat(inputTf.value) || 0;
      const lip = parseFloat(inputLip.value) || 0;
      
      const stdType = stdSelect.value;
      const activeProfileIdx = profSelect.value;
      const origProfile = currentCatalog[activeProfileIdx];
      if (!origProfile) return;

      // Calcular area y peso aproximado basado en la forma
      let area = 0.0;
      const shape = origProfile.shape;

      if (shape === 'PERFIL_I') {
        area = (2 * b * tf + (h - 2 * tf) * tw) / 100; // cm2
      } else if (shape === 'PERFIL_U') {
        area = (2 * b * tf + (h - 2 * tf) * tw) / 100; // cm2
      } else if (shape === 'PERFIL_C') {
        area = (2 * b * tf + (h - 2 * tf) * tw + 2 * lip * tw) / 100; // cm2
      } else if (shape === 'RECT_VAZIO') {
        area = (b * h - (b - 2 * tw) * (h - 2 * tw)) / 100; // cm2
      } else if (shape === 'CIRC_VAZIO') {
        const rOut = b / 2;
        const rIn = (b - 2 * tw) / 2;
        area = (Math.PI * (rOut*rOut - rIn*rIn)) / 100; // cm2
      }

      // Densidad del acero = 7.85 g/cm3 => kg/m = Area(cm2) * 0.785
      const density = origProfile.name.toLowerCase().includes('aluminio') ? 0.27 : 0.785;
      const weight = area * density;

      resArea.textContent = area.toFixed(2);
      resWeight.textContent = weight.toFixed(2);

      // Aproximar inercias de catálogo o mantener escalados
      resIx.textContent = origProfile.ix ? (origProfile.ix * (h / origProfile.h)).toFixed(1) : "0.0";
      resIy.textContent = origProfile.iy ? (origProfile.iy * (b / origProfile.b)).toFixed(1) : "0.0";

      // Actualizar código CAD
      const params = [
        `"CUSTOM_${b}x${h}"`,
        h.toFixed(1),
        b.toFixed(1),
        tw.toFixed(1),
        tf.toFixed(1)
      ];
      cadCodeText.textContent = `(EST-STEEL-Beam ${params.join(" ")})`;

      drawSVG({ shape, h, b, tw, tf, lip });
    }

    // Copiar código portapapeles
    btnCopy.addEventListener('click', () => {
      navigator.clipboard.writeText(cadCodeText.textContent);
      const originalText = btnCopy.textContent;
      btnCopy.textContent = 'Copiado!';
      btnCopy.style.background = '#22c55e';
      setTimeout(() => {
        btnCopy.textContent = originalText;
        btnCopy.style.background = 'var(--tmd-orange)';
      }, 2000);
    });

    // Iniciar
    init();
    setupInputListeners();
  </script>
</DocsLayout>
