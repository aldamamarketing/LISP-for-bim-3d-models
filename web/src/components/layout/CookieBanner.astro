---
// CookieBanner.astro — LGPD/GDPR consent
// Muestra si no hay 'lc-cookie-consent' en localStorage
---

<div
    id="cookie-banner"
    role="dialog"
    aria-live="polite"
    aria-label="Cookie consent"
    style="display:none"
    class="fixed bottom-0 left-0 right-0 z-[9999] p-4 md:p-6 opacity-0"
>
    <div class="max-w-4xl mx-auto bg-[#0f0f0f] border border-[#2a2a2a] rounded-2xl shadow-2xl p-5 md:p-6 flex flex-col md:flex-row gap-4 md:items-center">
        <div class="flex gap-3 items-start flex-1">
            <span class="text-2xl mt-0.5 shrink-0">🍪</span>
            <div>
                <p class="text-white font-semibold text-sm mb-1" id="cookie-title">We use cookies</p>
                <p class="text-on-surface-variant text-xs leading-relaxed" id="cookie-desc">
                    LispCentral uses essential cookies for authentication and optional analytics cookies (Firebase/Google Analytics) to improve the platform.
                    <a href="/privacy#cookies" id="cookie-link" class="text-primary-container underline hover:no-underline ml-1">Learn more</a>.
                </p>
            </div>
        </div>
        <div class="flex gap-3 shrink-0 flex-wrap">
            <button id="cookie-essential" class="px-4 py-2 rounded border border-[#3a3a3a] text-on-surface-variant hover:text-white hover:border-[#555] text-xs font-semibold transition-colors whitespace-nowrap">
                Essential only
            </button>
            <button id="cookie-accept" class="px-5 py-2 rounded bg-primary-container hover:bg-[#e66000] text-white text-xs font-bold transition-colors shadow-[0_0_12px_rgba(255,107,0,0.2)] whitespace-nowrap">
                Accept all
            </button>
        </div>
    </div>
</div>

<script>
const CONSENT_KEY = 'lc-cookie-consent';

const i18n = {
    pt: {
        title: 'Usamos cookies',
        desc: 'O LispCentral usa cookies essenciais para autenticação e cookies opcionais de análise (Firebase/Google Analytics) para melhorar a plataforma. ',
        link: 'Saiba mais',
        essential: 'Apenas essenciais',
        accept: 'Aceitar tudo',
        path: '/pt/privacy#cookies',
    },
    es: {
        title: 'Usamos cookies',
        desc: 'LispCentral usa cookies esenciales para autenticación y cookies opcionales de análisis (Firebase/Google Analytics) para mejorar la plataforma. ',
        link: 'Saber más',
        essential: 'Solo esenciales',
        accept: 'Aceptar todo',
        path: '/es/privacy#cookies',
    },
    en: {
        title: 'We use cookies',
        desc: 'LispCentral uses essential cookies for authentication and optional analytics cookies (Firebase/Google Analytics) to improve the platform. ',
        link: 'Learn more',
        essential: 'Essential only',
        accept: 'Accept all',
        path: '/privacy#cookies',
    },
};

function getLang() {
    const p = window.location.pathname;
    if (p.startsWith('/pt')) return 'pt';
    if (p.startsWith('/es')) return 'es';
    return 'en';
}

function hideBanner() {
    const el = document.getElementById('cookie-banner');
    if (el) { el.style.opacity = '0'; setTimeout(() => { el.style.display = 'none'; }, 300); }
}

function showBanner() {
    const el = document.getElementById('cookie-banner');
    if (!el) return;
    const lang = getLang();
    const t = i18n[lang] || i18n.en;

    const titleEl = document.getElementById('cookie-title');
    const descEl  = document.getElementById('cookie-desc');
    const linkEl  = document.getElementById('cookie-link');
    const essBtn  = document.getElementById('cookie-essential');
    const accBtn  = document.getElementById('cookie-accept');

    if (titleEl) titleEl.textContent = t.title;
    if (linkEl)  { linkEl.textContent = t.link; linkEl.href = t.path; }
    if (descEl)  { descEl.firstChild!.textContent = t.desc; }
    if (essBtn)  essBtn.textContent = t.essential;
    if (accBtn)  accBtn.textContent = t.accept;

    el.style.display = 'block';
    requestAnimationFrame(() => {
        el.style.transition = 'opacity 0.4s ease';
        el.style.opacity = '1';
    });
}

function initBanner() {
    if (localStorage.getItem(CONSENT_KEY)) return;
    setTimeout(showBanner, 900);

    document.getElementById('cookie-accept')?.addEventListener('click', () => {
        localStorage.setItem(CONSENT_KEY, 'all');
        hideBanner();
        window.dispatchEvent(new CustomEvent('lc:consent', { detail: { level: 'all' } }));
    });

    document.getElementById('cookie-essential')?.addEventListener('click', () => {
        localStorage.setItem(CONSENT_KEY, 'essential');
        hideBanner();
        window.dispatchEvent(new CustomEvent('lc:consent', { detail: { level: 'essential' } }));
    });
}

document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', initBanner)
    : initBanner();
</script>
