---
import { translations } from '../../i18n/translations.js';
import { getLangFromUrl, localizeUrl } from '../../i18n/utils.js';

const currentLocale = getLangFromUrl(Astro.url);
const t = (key) => {
    const dict = translations[currentLocale] || translations['en'];
    return dict[key] || key;
};
---
<header class="fixed w-full top-0 z-50 flex flex-col shadow-xl">
    <nav class="w-full transition-all duration-300" style="background: rgba(18,20,20,0.85); backdrop-filter: blur(12px); border-bottom: 1px solid var(--surface-variant, #343535);">
    <div class="flex justify-between items-center px-6 py-3 max-w-[1400px] mx-auto">
        
        <!-- Logo -->
        <a href={localizeUrl('/', currentLocale)} class="flex items-center gap-2 text-white hover:text-primary-container transition-colors group">
            <span class="material-symbols-outlined text-primary-container group-hover:text-white transition-colors">code_blocks</span>
            <span class="font-bold text-xl tracking-tight">LispCentral</span>
        </a>

        <!-- Desktop Nav moved to global sidebar -->

        <!-- Desktop Actions -->
        <div class="hidden md:flex items-center gap-4">
            <div class="flex items-center gap-1 bg-[#0D0D0D] border border-surface-variant rounded-lg px-2 py-1.5">
                <span class="material-symbols-outlined text-[16px] text-on-surface-variant">translate</span>
                <select id="lang-selector-desktop" class="bg-transparent text-white text-sm outline-none cursor-pointer border-none py-0.5 pr-1">
                    <option value="en" selected={currentLocale === 'en'} class="bg-[#0D0D0D]">EN</option>
                    <option value="es" selected={currentLocale === 'es'} class="bg-[#0D0D0D]">ES</option>
                    <option value="pt" selected={currentLocale === 'pt'} class="bg-[#0D0D0D]">PT</option>
                </select>
            </div>
            <a id="desktop-login-btn" href={localizeUrl('/login', currentLocale)} class="text-on-surface-variant hover:text-white font-medium transition-colors text-sm" data-i18n="header.login">
                {t("header.login")}
            </a>
        </div>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="md:hidden flex items-center justify-center text-on-surface-variant hover:text-white p-2 rounded-lg bg-transparent hover:bg-surface-container transition-colors" aria-label="Menu">
            <span class="material-symbols-outlined text-[28px]">menu</span>
        </button>
    </div>
</nav>

<!-- Beta Banner (Under Header) -->
<div id="beta-banner" style="display: none;" class="w-full bg-[#1a1200] border-b border-amber-500/30 text-amber-300 text-center py-1.5 px-4 text-xs md:text-sm font-medium items-center justify-center gap-2 relative transition-all duration-300 shadow-[inset_0_-1px_10px_rgba(245,158,11,0.05)]">
    <span class="text-base leading-none">🧪</span>
    {currentLocale === 'pt' && <span>Beta Público — Plataforma funcional. Algumas ferramentas ainda em aprimoramento.</span>}
    {currentLocale === 'es' && <span>Beta Pública — Plataforma funcional. Algunas herramientas aún en refinamiento.</span>}
    {(currentLocale !== 'pt' && currentLocale !== 'es') && <span>Public Beta — Platform functional. Some tools still being refined.</span>}
    <button id="close-beta-banner" aria-label="Close" class="absolute right-4 top-1/2 -translate-y-1/2 text-amber-400/60 hover:text-amber-300 transition-colors text-xl leading-none">&times;</button>
</div>

<script is:inline>
    (function() {
        if (!localStorage.getItem('lc-beta-read')) {
            const b = document.getElementById('beta-banner');
            if (b) b.style.display = 'flex';
        }
        const btn = document.getElementById('close-beta-banner');
        if (btn) {
            btn.addEventListener('click', () => {
                localStorage.setItem('lc-beta-read', '1');
                const b = document.getElementById('beta-banner');
                if (b) b.remove();
            });
        }
    })();
</script>

</header>

<!-- Mobile Navigation Panel -->
<div id="mobile-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[90] opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"></div>
<div id="mobile-panel" class="fixed top-0 right-0 h-full w-[280px] bg-surface-container border-l border-surface-variant z-[100] transform translate-x-full transition-transform duration-300 md:hidden flex flex-col shadow-elevation-3">
    <div class="p-6 border-b border-surface-variant flex justify-between items-center">
        <span class="font-bold text-lg text-white">Menu</span>
        <button id="mobile-close-btn" class="text-on-surface-variant hover:text-white p-1 rounded-lg hover:bg-surface-container-high transition-colors" aria-label="Close">
            <span class="material-symbols-outlined text-[24px]">close</span>
        </button>
    </div>
    <div class="flex-1 overflow-y-auto p-6 flex flex-col gap-6">
        <nav class="flex flex-col gap-4">
            <a href={localizeUrl('/', currentLocale)} class="text-white font-medium text-lg border-l-2 border-primary-container pl-3"><span data-i18n="header.home">{t("header.home")}</span></a>
            
            <div class="flex flex-col gap-2 mt-2">
                <span class="text-primary-container text-xs font-bold uppercase tracking-wider pl-3" data-i18n="header.tools">{t("header.tools") || "Tools"}</span>
                <a href={localizeUrl('/tools/hatch-generator', currentLocale)} class="flex items-center gap-3 text-on-surface-variant hover:text-white pl-3 py-2 rounded-lg hover:bg-surface-container-high transition-colors">
                    <span class="material-symbols-outlined text-[20px]">grid_view</span> <span data-i18n="header.hatch">{t("header.hatch")}</span>
                </a>
                <a href={localizeUrl('/tools/linetype-generator', currentLocale)} class="flex items-center gap-3 text-on-surface-variant hover:text-white pl-3 py-2 rounded-lg hover:bg-surface-container-high transition-colors">
                    <span class="material-symbols-outlined text-[20px]">line_style</span> <span data-i18n="header.lines">{t("header.lines")}</span>
                </a>
                <a href={localizeUrl('/tools/icon-generator', currentLocale)} class="flex items-center gap-3 text-on-surface-variant hover:text-white pl-3 py-2 rounded-lg hover:bg-surface-container-high transition-colors">
                    <span class="material-symbols-outlined text-[20px]">image</span> <span data-i18n="header.icons">{t("header.icons")}</span>
                </a>
                <a href={localizeUrl('/tools/calc-viga', currentLocale)} class="flex items-center gap-3 text-on-surface-variant hover:text-white pl-3 py-2 rounded-lg hover:bg-surface-container-high transition-colors">
                    <span class="material-symbols-outlined text-[20px]">architecture</span> <span data-i18n="header.profiles">{t("header.profiles")}</span>
                </a>
            </div>

            <!-- Contextual Dashboard Menu (Visible only when logged in) -->
            <div id="mobile-dashboard-nav" class="hidden flex-col gap-2 mt-2">
                <span class="text-primary-container text-xs font-bold uppercase tracking-wider pl-3" data-i18n="dashboard.sidebar.sectionMain">{t("dashboard.sidebar.sectionMain")}</span>
                <a href={localizeUrl('/dashboard#files', currentLocale)} class="dashboard-link flex items-center gap-3 text-on-surface-variant hover:text-white pl-3 py-2 rounded-lg hover:bg-surface-container-high transition-colors">
                    <span class="material-symbols-outlined text-[20px]">folder_copy</span> <span data-i18n="dashboard.sidebar.manager">{t("dashboard.sidebar.manager")}</span>
                </a>
                <a href={localizeUrl('/dashboard#favorites', currentLocale)} class="dashboard-link flex items-center gap-3 text-on-surface-variant hover:text-white pl-3 py-2 rounded-lg hover:bg-surface-container-high transition-colors">
                    <span class="material-symbols-outlined text-[20px]">star</span> <span data-i18n="dashboard.sidebar.collection">{t("dashboard.sidebar.collection")}</span>
                </a>
                <a href={localizeUrl('/dashboard#profile', currentLocale)} class="dashboard-link flex items-center gap-3 text-on-surface-variant hover:text-white pl-3 py-2 rounded-lg hover:bg-surface-container-high transition-colors">
                    <span class="material-symbols-outlined text-[20px]">person</span> <span data-i18n="dashboard.sidebar.profile">{t("dashboard.sidebar.profile")}</span>
                </a>
                <a href={localizeUrl('/dashboard#subscriptions', currentLocale)} class="dashboard-link flex items-center gap-3 text-on-surface-variant hover:text-white pl-3 py-2 rounded-lg hover:bg-surface-container-high transition-colors">
                    <span class="material-symbols-outlined text-[20px]">shopping_bag</span> <span data-i18n="dashboard.subscriptions.title">{t("dashboard.subscriptions.title")}</span>
                </a>
                <a href={localizeUrl('/dashboard#licenses', currentLocale)} class="dashboard-link flex items-center gap-3 text-on-surface-variant hover:text-white pl-3 py-2 rounded-lg hover:bg-surface-container-high transition-colors">
                    <span class="material-symbols-outlined text-[20px]">vpn_key</span> <span data-i18n="dashboard.sidebar.licenses">{t("dashboard.sidebar.licenses")}</span>
                </a>
                <a href={localizeUrl('/dashboard#notifications', currentLocale)} class="dashboard-link flex items-center gap-3 text-on-surface-variant hover:text-white pl-3 py-2 rounded-lg hover:bg-surface-container-high transition-colors">
                    <span class="material-symbols-outlined text-[20px]">notifications</span> <span data-i18n="dashboard.sidebar.notifications">{t("dashboard.sidebar.notifications")}</span>
                </a>
            </div>

            <a href={localizeUrl('/blog', currentLocale)} class="text-on-surface-variant hover:text-white font-medium text-base pl-3 mt-2" data-i18n="header.blog">{t("header.blog") || "Blog"}</a>
        </nav>
        
        <div class="mt-auto pt-6 border-t border-surface-variant flex flex-col gap-4">
            <a id="mobile-login-btn" href={localizeUrl('/login', currentLocale)} class="text-center font-medium text-white bg-surface-container-high py-3 rounded-lg hover:bg-surface-variant transition-colors" data-i18n="header.login">
                {t("header.login")}
            </a>
            <a id="mobile-help-btn" href={localizeUrl('/help', currentLocale)} class="text-center font-bold text-white bg-primary-container py-3 rounded-lg hover:bg-[#e66000] shadow-glow-orange transition-all" data-i18n="header.help">
                {t("header.help")}
            </a>
            <div class="flex items-center justify-center gap-2 mt-4">
                <span class="material-symbols-outlined text-[18px] text-on-surface-variant">translate</span>
                <select id="lang-selector-mobile" class="bg-[#0D0D0D] border border-surface-variant rounded-lg text-white text-sm px-3 py-2 outline-none">
                    <option value="en" selected={currentLocale === 'en'}>English (EN)</option>
                    <option value="es" selected={currentLocale === 'es'}>Español (ES)</option>
                    <option value="pt" selected={currentLocale === 'pt'}>Português (PT)</option>
                </select>
            </div>
        </div>
    </div>
</div>

<script>
  // Language Selector Logic
  const handleLangChange = (e) => {
    const newLang = e.target.value;
    localStorage.setItem('lc-lang', newLang);
    const currentPath = window.location.pathname;
    
    // Safely remove /es or /pt prefix, handling trailing slashes correctly
    let pathWithoutLang = currentPath.replace(/^\/(es|pt)(\/|$)/, '/');
    
    if (newLang === 'en') {
        window.location.href = pathWithoutLang;
    } else {
        // Since pathWithoutLang always starts with '/', we just prepend /lang
        // e.g. pathWithoutLang = '/help' -> '/es/help'
        // If pathWithoutLang = '/' -> '/es/'
        let target = `/${newLang}${pathWithoutLang}`;
        // Prevent double slashes at the end like /es//
        if (target.endsWith('//')) target = target.slice(0, -1);
        window.location.href = target;
    }
  };

  const langDesktop = document.getElementById('lang-selector-desktop');
  const langMobile = document.getElementById('lang-selector-mobile');
  
  if (langDesktop) langDesktop.addEventListener('change', handleLangChange);
  if (langMobile) langMobile.addEventListener('change', handleLangChange);

  // Sync selector and localStorage with the actual URL language
  const path = window.location.pathname;
  let urlLang = 'en';
  if (path === '/es' || path.startsWith('/es/')) urlLang = 'es';
  else if (path === '/pt' || path.startsWith('/pt/')) urlLang = 'pt';
  
  localStorage.setItem('lc-lang', urlLang);
  
  if (langDesktop) langDesktop.value = urlLang;
  if (langMobile) langMobile.value = urlLang;

  // Mobile Menu Logic
  const menuBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-close-btn');
  const overlay = document.getElementById('mobile-overlay');
  const panel = document.getElementById('mobile-panel');

  const openMenu = () => {
      if(overlay && panel) {
        overlay.classList.remove('opacity-0', 'pointer-events-none');
        panel.classList.remove('translate-x-full');
        document.body.style.overflow = 'hidden';
      }
  };

  const closeMenu = () => {
      if(overlay && panel) {
        overlay.classList.add('opacity-0', 'pointer-events-none');
        panel.classList.add('translate-x-full');
        document.body.style.overflow = '';
      }
  };

  if(menuBtn) menuBtn.addEventListener('click', openMenu);
  if(closeBtn) closeBtn.addEventListener('click', closeMenu);
  if(overlay) overlay.addEventListener('click', closeMenu);

  // Handle clicking dashboard links (close menu after click)
  const dashboardLinks = document.querySelectorAll('.dashboard-link');
  dashboardLinks.forEach(link => {
      link.addEventListener('click', () => {
          closeMenu();
      });
  });
</script>

<!-- Firebase Auth context for Header -->
<script>
    import { auth } from '../../firebase';
    import { onAuthStateChanged, signOut } from 'firebase/auth';
    import { translations } from '../../i18n/translations.js';

    document.addEventListener('DOMContentLoaded', () => {
        const dashboardNav = document.getElementById('mobile-dashboard-nav');
        const loginBtn = document.getElementById('mobile-login-btn');
        const desktopLoginBtn = document.getElementById('desktop-login-btn');
        const helpBtn = document.getElementById('mobile-help-btn');
        
        onAuthStateChanged(auth, (user) => {
            const storedLang = localStorage.getItem('lc-lang') || 'en';
            const dict = translations[storedLang] || translations['en'];

            if (user) {
                // Logged in
                if (dashboardNav) {
                    dashboardNav.classList.remove('hidden');
                    dashboardNav.classList.add('flex');
                }
                if (loginBtn) {
                    loginBtn.textContent = dict['dashboard.sidebar.logout'] || 'Sign Out';
                    loginBtn.href = '#';
                    loginBtn.addEventListener('click', (e) => {
                        e.preventDefault();
                        signOut(auth).then(() => {
                            window.location.href = '/';
                        });
                    });
                }
                if (desktopLoginBtn) {
                    // Si está en la landing u otra página sin sidebar, 
                    // el botón "Login" cambia a "Dashboard" y lo lleva al portal.
                    // Desde el dashboard podrá hacer logout en el sidebar.
                    desktopLoginBtn.textContent = dict['header.portal'] || 'Dashboard';
                    const currentLang = window.location.pathname.split('/')[1];
                    const isLangPrefix = currentLang === 'es' || currentLang === 'pt';
                    desktopLoginBtn.href = isLangPrefix ? `/${currentLang}/dashboard` : '/dashboard';
                }
                // Optionally hide help btn to save space
                if (helpBtn) {
                    helpBtn.classList.add('hidden');
                }
            } else {
                // Not logged in
                if (dashboardNav) {
                    dashboardNav.classList.add('hidden');
                    dashboardNav.classList.remove('flex');
                }
                if (desktopLoginBtn) {
                    desktopLoginBtn.textContent = dict['header.login'] || 'Login';
                    const currentLang = window.location.pathname.split('/')[1];
                    const isLangPrefix = currentLang === 'es' || currentLang === 'pt';
                    desktopLoginBtn.href = isLangPrefix ? `/${currentLang}/login` : '/login';
                }
                if (loginBtn) {
                    loginBtn.textContent = dict['header.login'] || 'Login';
                    const currentLang = window.location.pathname.split('/')[1];
                    const isLangPrefix = currentLang === 'es' || currentLang === 'pt';
                    loginBtn.href = isLangPrefix ? `/${currentLang}/login` : '/login';
                }
            }
        });
    });
</script>
