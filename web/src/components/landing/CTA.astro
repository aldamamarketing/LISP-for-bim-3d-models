---
import { translations } from '../../i18n/translations.js';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = (key) => translations[lang]?.[key] || translations['en'][key];
---
<section class="py-24 bg-primary-container/5 border-t border-surface-variant reveal" id="falar-especialista">
    <div class="max-w-3xl mx-auto px-gutter text-center">
        <h2 class="font-headline-lg text-headline-lg text-white mb-6">{t("cta.title")}</h2>
        <p class="font-body-md text-body-md text-on-surface-variant mb-10">
            {t("cta.desc")}
        </p>
        <div class="flex justify-center mt-8">
            <a href="/login" class="bg-primary-container text-white font-label-md text-[18px] font-bold px-10 py-4 rounded hover:bg-[#e66000] transition-colors whitespace-nowrap shadow-[0_0_20px_rgba(255,107,0,0.3)] hover:-translate-y-1">
                {t("cta.button")}
            </a>
        </div>
        <p class="mt-4 font-code-sm text-code-sm text-on-surface-variant">{t("cta.disclaimer")}</p>
    </div>
</section>
