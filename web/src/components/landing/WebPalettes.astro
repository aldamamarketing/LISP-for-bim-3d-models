---
import { translations } from '../../i18n/translations.js';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = (key) => translations[lang]?.[key] || translations['en'][key];
---
<section class="py-section-padding relative overflow-hidden reveal">
    <div class="max-w-container-max-width mx-auto px-gutter">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div>
                <h2 class="font-headline-lg text-headline-lg text-white mb-6">{t("palettes.title")}</h2>
                <p class="font-body-lg text-body-lg text-on-surface-variant mb-8">
                    {t("palettes.desc")}
                </p>
                <ul class="space-y-4">
                    <li class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-primary-container mt-1">check_circle</span>
                        <div>
                            <strong class="text-white font-label-md text-label-md block mb-1">{t("palettes.sync.title")}</strong>
                            <span class="text-on-surface-variant font-body-md text-code-sm block">{t("palettes.sync.desc")}</span>
                        </div>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="material-symbols-outlined text-primary-container mt-1">check_circle</span>
                        <div>
                            <strong class="text-white font-label-md text-label-md block mb-1">{t("palettes.search.title")}</strong>
                            <span class="text-on-surface-variant font-body-md text-code-sm block">{t("palettes.search.desc")}</span>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="relative">
                <div class="absolute inset-0 bg-gradient-to-tr from-primary-container/20 to-transparent blur-2xl rounded-full"></div>
                <img src="/images/autocad_palette_ui.jpg" alt={t("palettes.image_alt")} class="w-full h-auto rounded-lg border border-[#262626] shadow-2xl relative z-10" loading="lazy" />
            </div>
        </div>
    </div>
</section>
