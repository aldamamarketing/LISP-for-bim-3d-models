---
import { translations } from '../../i18n/translations.js';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = (key) => {
    const dict = translations[lang] || translations['en'];
    return dict[key] || key;
};
---
<section class="relative pt-section-padding pb-section-padding overflow-hidden">
    <div class="absolute inset-0 bg-grid-pattern pointer-events-none"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-primary-container/10 blur-[120px] rounded-full pointer-events-none"></div>
    <div class="max-w-container-max-width mx-auto px-gutter relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <span class="inline-block py-1 px-3 rounded-full bg-surface-container border border-surface-variant text-primary font-code-sm text-code-sm mb-6">
                <span class="material-symbols-outlined text-[14px] align-middle mr-1">code</span>
                {t('landing.hero.tag')}
            </span>
            <h1 class="font-headline-xl text-headline-xl mb-6 text-white">
                {t('landing.hero.title1')} <span class="text-primary-container">{t('landing.hero.title2')}</span>
            </h1>
            <p class="font-body-lg text-body-lg text-on-surface-variant mb-10">
                {t('landing.hero.desc')}
            </p>
            <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
                <a href="#comecar" class="w-full sm:w-auto bg-primary-container text-white font-label-md text-label-md font-bold px-8 py-4 rounded hover:bg-[#e66000] transition-all shadow-[0_0_20px_rgba(255,107,0,0.3)] text-center">
                    {t('landing.hero.cta1')}
                </a>
                <a href="#demo" class="w-full sm:w-auto border border-surface-variant text-white font-label-md text-label-md font-bold px-8 py-4 rounded hover:border-primary-container hover:text-primary-container transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined">play_circle</span>
                    {t('landing.hero.cta2')}
                </a>
            </div>
        </div>
        
        <!-- Tablet Image Showcase -->
        <div class="relative max-w-4xl mx-auto mt-20">
            <div class="absolute -inset-4 bg-gradient-to-b from-surface-container-high to-transparent opacity-50 rounded-xl blur-lg"></div>
            <img alt="LispCentral Cloud Computing" class="w-full h-auto rounded-xl border border-surface-variant shadow-2xl relative z-10" src="/images/cloud_lisp_concept.jpg" loading="lazy" />
        </div>
    </div>
</section>
