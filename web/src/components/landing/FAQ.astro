---
import { translations } from '../../i18n/translations.js';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = (key) => translations[lang]?.[key] || translations['en'][key];

const faqs = [
  {
    question: t("faq.q1.q"),
    answer: t("faq.q1.a")
  },
  {
    question: t("faq.q2.q"),
    answer: t("faq.q2.a")
  },
  {
    question: t("faq.q3.q"),
    answer: t("faq.q3.a")
  },
  {
    question: t("faq.q4.q"),
    answer: t("faq.q4.a")
  }
];
---
<section class="py-section-padding relative overflow-hidden bg-background border-t border-surface-variant reveal">
    <div class="max-w-[800px] mx-auto px-gutter relative z-10">
        <div class="text-center mb-16">
            <h2 class="font-headline-lg text-headline-lg text-white mb-4">{t("faq.title")}</h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant">{t("faq.desc")}</p>
        </div>
        
        <div class="space-y-4">
            {faqs.map((faq) => (
                <div class="bg-[#0D0D0D] border border-[#262626] rounded-xl p-6 hover:border-primary-container/50 transition-colors shadow-lg">
                    <h3 class="font-headline-md text-headline-md text-white text-[20px] mb-3">{faq.question}</h3>
                    <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">{faq.answer}</p>
                </div>
            ))}
        </div>
    </div>
</section>
