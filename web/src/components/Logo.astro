---
// Logo.astro
// Representa "(LC)" con paréntesis naranjas y texto adaptable.
---
<div class="tmd-logo">
  <span class="paren">(</span><span class="text">LC</span><span class="paren">)</span>
</div>

<style>
  .tmd-logo {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: -1px;
    display: inline-flex;
    align-items: center;
    user-select: none;
  }
  .paren { color: var(--tmd-orange); }
  .text { color: var(--text-main); }
</style>
