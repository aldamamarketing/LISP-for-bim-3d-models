---
// Logo.astro
// Representa "((LC))" simulando paréntesis como L y C.
---
<div class="tmd-logo">
  <span class="l-paren">((</span><span class="l-text">L</span><span class="c-text">C</span><span class="r-paren">))</span>
</div>

<style>
  .tmd-logo {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-weight: 800;
    font-size: 1.6rem;
    letter-spacing: -1px;
    display: inline-flex;
    align-items: center;
    user-select: none;
  }
  .l-paren { color: #f0f0f0; margin-right: -2px; }
  .l-text { color: #f0f0f0; }
  .c-text { color: var(--tmd-orange); }
  .r-paren { color: var(--tmd-orange); margin-left: -2px; }
</style>
